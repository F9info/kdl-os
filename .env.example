# ── Core ─────────────────────────────────────────────
NODE_ENV=development
APP_PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
AI_SERVICES_URL=http://localhost:5000
JWT_SECRET=change_this_min_64_chars
JWT_REFRESH_SECRET=change_this_min_64_chars_refresh_different
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# JWT_ISSUER=kdl-os          # Optional — defaults to kdl-os
# JWT_AUDIENCE=kdl-os-api    # Optional — defaults to kdl-os-api
CORS_ORIGIN=http://localhost:3000

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/kdl_db

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ── AI Brains ─────────────────────────────────────────
# Main brain — Claude (via Paperclip AI subscription — no key needed here)
ANTHROPIC_API_KEY=via_paperclip_subscription

# Budget brain — OpenRouter (fill your key below)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_DEFAULT_MODEL=moonshot-ai/moonshot-v1-32k
OPENROUTER_WHISPER_MODEL=openai/whisper-1
OPENROUTER_DAILY_BUDGET=2.00

# ── Voice (Whisper only) ──────────────────────────────
OPENAI_API_KEY=sk-your-whisper-key-here

# ── ChromaDB ─────────────────────────────────────────
CHROMADB_URL=http://localhost:8000

# ── Storage (MinIO) ───────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kdl-media

# ── Search (MeiliSearch) ──────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILI_MASTER_KEY=masterKey
# Scoped search-only key for ai-services (generate via /keys with the master key; grant only "search")
MEILI_SEARCH_API_KEY=scoped-search-key

# ── Storage driver (KDL-119 A7 / KDL-224) ───────────────────────────────────
# Env-only drivers (legacy — configure via STORAGE_DRIVER):
# STORAGE_DRIVER=minio   # default (uses minio config above)
# STORAGE_DRIVER=local   # local filesystem — also set LOCAL_STORAGE_PATH
# STORAGE_DRIVER=s3      # AWS S3 — also set AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, S3_BUCKET
# STORAGE_DRIVER=spaces  # DigitalOcean Spaces — also set AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, S3_BUCKET
# STORAGE_DRIVER=r2      # Cloudflare R2 — also set R2_ACCOUNT_ID, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, S3_BUCKET
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=kdl-media
# S3_ENDPOINT=            # custom endpoint for non-AWS S3 (auto-set for r2/spaces)
# R2_ACCOUNT_ID=          # Cloudflare account id (r2 only)
# LOCAL_STORAGE_PATH=uploads/media          # local driver: where files are stored
# LOCAL_STORAGE_BASE_URL=http://localhost:4000  # local driver: base URL for presign URLs
# DB-driven storage config (set via /api/storage-settings — overrides STORAGE_DRIVER env):
# provider, endpoint, region, bucket, accessKey, secretKey are stored in app_settings (secrets encrypted).

# ── Virus scan (ClamAV, KDL-119 A6) ──────────────────
# Unset = uploads recorded as scan_result SKIPPED (dev default).
# Enable: CLAMAV_HOST=clamav (docker) or localhost (host), start compose `scan` profile.
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=30000

# ── Payments ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
RAZORPAY_KEY_ID=rzp_test_your_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ── Email (SMTP) ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=KDL Starter Kit <noreply@kdl.com>

# ── Vault ────────────────────────────────────────────
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token

# ── Observability ─────────────────────────────────────
SENTRY_DSN=your_sentry_dsn

# Integrations module — AES-256-GCM master key for provider credentials (32-byte hex)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# ── Cloud imports (KDL-122 D8) ─────────────────────────
# Google Drive / Dropbox / OneDrive are OAuth apps registered per-deployment.
# Unset client id/secret = provider hidden in UI, 501 on /import/oauth/:provider/start.
# APP_PUBLIC_URL is the backend's own public origin (used to build the OAuth
# redirect_uri registered with each provider) — defaults to http://localhost:$APP_PORT.
# APP_PUBLIC_URL=http://localhost:4000
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# DROPBOX_CLIENT_ID=
# DROPBOX_CLIENT_SECRET=
# ONEDRIVE_CLIENT_ID=
# ONEDRIVE_CLIENT_SECRET=
# ONEDRIVE_TENANT=common
# S3 bucket import and FTP import take credentials directly from the user (no app-level config needed).
