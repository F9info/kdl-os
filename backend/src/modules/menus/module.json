{
  "slug": "menus",
  "name": "Website",
  "version": "1.0.0",
  "description": "Multi-level drag-and-drop navigation menus (header, footer, mobile)",
  "core": false,
  "group": "cms",
  "visibleInCatalog": false,
  "apiPrefix": "/api/menus",
  "permissions": [
    "menus"
  ],
  "nav": [
    {
      "label": "Brands",
      "path": "/admin/brands",
      "icon": "Globe",
      "permission": "menus:view",
      "activeWhen": {
        "pathStartsWith": "/admin/template-engine/projects/",
        "pathEndsWith": "/website",
        "viewNotIn": [
          "pages",
          "layouts",
          "navigation"
        ]
      }
    },
    {
      "label": "Website Details",
      "path": "/admin/website-details",
      "icon": "Building2",
      "permission": "menus:view"
    },
    {
      "label": "Color Palette",
      "path": "/admin/color-palette",
      "icon": "Palette",
      "permission": "menus:view",
      "activeWhen": {
        "pathStartsWith": "/admin/template-engine/projects/",
        "pathEndsWith": "/palette"
      }
    },
    {
      "label": "Navigation",
      "path": "/admin/menus",
      "icon": "Menu",
      "permission": "menus:view",
      "activeWhen": {
        "pathStartsWith": "/admin/template-engine/projects/",
        "pathEndsWith": "/website",
        "view": "navigation"
      }
    },
    {
      "label": "Layouts",
      "path": "/admin/layouts",
      "icon": "PanelTop",
      "permission": "menus:view",
      "activeWhen": {
        "pathStartsWith": "/admin/template-engine/projects/",
        "pathEndsWith": "/website",
        "view": "layouts"
      }
    },
    {
      "label": "Pages",
      "path": "/admin/pages",
      "icon": "FileText",
      "permission": "menus:view",
      "activeWhen": {
        "pathStartsWith": "/admin/template-engine/projects/",
        "pathEndsWith": "/website",
        "view": "pages"
      }
    },
    {
      "label": "Sections",
      "path": "/admin/page-builder/section-builder",
      "icon": "LayoutTemplate",
      "permission": "page-builder:view"
    }
  ],
  "dependsOn": [],
  "queues": [],
  "env": []
}
