{
  "slug": "media",
  "name": "Media",
  "version": "1.0.0",
  "description": "File upload and media library",
  "core": true,
  "group": "core",
  "apiPrefix": "/api/media",
  "permissions": [
    {
      "name": "media",
      "actions": [
        "view",
        "edit",
        "publish",
        "approve",
        "share",
        "upload",
        "download",
        "preview",
        "edit-image",
        "share-link",
        "folders",
        "collections",
        "tags",
        "favorites",
        "metadata-edit",
        "custom-fields",
        "visibility-toggle",
        "soft-delete",
        "trash-view",
        "restore",
        "purge",
        "cloud-import",
        "ai-providers",
        "capture"
      ]
    }
  ],
  "nav": [
    {
      "label": "Library",
      "path": "/admin/media",
      "icon": "Image",
      "permission": "media:view",
      "group": "Media",
      "groupIcon": "Image",
      "groupOrder": 10,
      "order": 10
    },
    {
      "label": "AI Providers",
      "path": "/admin/media/ai",
      "icon": "Sparkles",
      "permission": "media:ai-providers",
      "group": "Media",
      "order": 20
    },
    {
      "label": "Cloud Imports",
      "path": "/admin/media/import",
      "icon": "CloudUpload",
      "permission": "media:cloud-import",
      "group": "Media",
      "order": 30
    }
  ],
  "dependsOn": [],
  "queues": [],
  "env": [
    "MINIO_ENDPOINT",
    "MINIO_ACCESS_KEY",
    "MINIO_SECRET_KEY",
    "MINIO_BUCKET"
  ]
}
