enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

enum MediaVisibility {
  PRIVATE
  SHARED
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  phone           String?
  password_hash   String
  is_active       Boolean   @default(true)
  status          UserStatus @default(ACTIVE)
  must_change_password Boolean @default(false)
  avatar_media_id String?
  last_login_at   DateTime?
  deleted_at      DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  refresh_tokens       RefreshToken[]
  password_reset_tokens PasswordResetToken[]
  media                Media[]
  roles                UserRole[]
  permission_overrides UserPermission[]
  activity             ActivityLog[]
  notifications        Notification[]
  notification_preferences NotificationPreference[]
  media_favorites      MediaFavorite[]
  media_comments       MediaComment[]            @relation("MediaCommentAuthor")
  media_shares         MediaShare[]              @relation("MediaShareCreator")

  @@index([status])
  @@index([deleted_at])
  @@map("users")
}

model RefreshToken {
  id         String   @id @default(cuid())
  user_id    String
  token_hash String   @unique
  family_id  String?
  expires_at DateTime
  revoked    Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([family_id])
  @@index([expires_at, revoked])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  user_id    String
  token_hash String   @unique
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at, used])
  @@map("password_reset_tokens")
}

model AppSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  type        String   @default("string")
  description String?
  is_public   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("app_settings")
}

model Type {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  is_active      Boolean        @default(true)
  owner_module   String?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  categories     Category[]
  setting_fields SettingField[]

  @@index([is_active])
  @@index([name])
  @@index([owner_module])
  @@map("types")
}

model Category {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  type_id        String?
  is_active      Boolean        @default(true)
  owner_module   String?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  type           Type?          @relation(fields: [type_id], references: [id], onDelete: SetNull)
  setting_fields SettingField[]

  @@index([is_active])
  @@index([type_id])
  @@index([name])
  @@index([owner_module])
  @@map("categories")
}

model SettingField {
  id          String    @id @default(cuid())
  field_name  String
  slug        String    @unique
  input_type  String
  value       String?
  alt_text    String?
  options     String?
  type_id     String
  category_id String?
  sort        Int       @default(0)
  owner_module String?
  locked_by   String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  type           Type           @relation(fields: [type_id], references: [id], onDelete: Cascade)
  category       Category?      @relation(fields: [category_id], references: [id], onDelete: SetNull)
  setting_values SettingValue[]

  @@index([type_id])
  @@index([category_id])
  @@index([sort])
  @@index([owner_module])
  @@index([locked_by])
  @@map("setting_fields")
}

model SettingValue {
  id         String   @id @default(cuid())
  platform   String // webapp | tv | android | ios  (denormalized for fast per-platform load)
  field_id   String   @unique
  value      String // stringified; JSON for imglist/fonts/multiselect
  updated_by String?
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  field SettingField @relation(fields: [field_id], references: [id], onDelete: Cascade)

  @@index([platform])
  @@map("setting_values")
}

model Media {
  id            String     @id @default(cuid())
  user_id       String
  folder_id     String?
  filename      String
  original_name String
  mime_type     String
  size          Int
  bucket        String
  path          String
  url           String?
  title         String?
  alt_text      String?
  caption       String?
  width         Int?
  height        Int?
  duration      Int?
  variants      Json?
  type          MediaType  @default(OTHER)
  visibility    MediaVisibility @default(PRIVATE) // KDL-150 — per-user/shared media
  exif          Json?
  checksum      String?
  scanned_at    DateTime?
  scan_result   String?
  ocr_text        String?             // Phase D3 — tesseract/pdftotext output, indexed in Meili
  transcript      Json?               // Phase D4 — whisper segments (verbose_json shape)
  transcript_text String?             // Phase D4 — flat transcript text, indexed in Meili
  transcript_lang String?             // Phase D4 — detected/requested language code
  barcodes        Json?               // Phase D7 — zxing-decoded QR/barcode hits: [{ value, format }], indexed in Meili
  owner_module    String?             // KDL-512 — same ownership contract as settings tables (KDL-192/197)
  // Phase B — workflow / delivery
  workflow_status MediaWorkflowStatus @default(DRAFT)
  published_at    DateTime?
  expires_at      DateTime?
  last_used_at    DateTime?
  is_archived     Boolean             @default(false)
  deleted_at      DateTime?
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt

  user             User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  folder           MediaFolder?          @relation(fields: [folder_id], references: [id], onDelete: SetNull)
  usages           MediaUsage[]
  tags             MediaTagPivot[]
  meta_values      MediaMetaValue[]
  collection_items MediaCollectionItem[]
  favorites        MediaFavorite[]
  versions         MediaVersion[]
  suggestions      MediaSuggestion[]
  shares           MediaShare[]
  comments         MediaComment[]

  @@index([user_id])
  @@index([folder_id])
  @@index([type])
  @@index([visibility])
  @@index([deleted_at])
  @@index([checksum])
  @@index([last_used_at])
  @@index([workflow_status])
  @@index([expires_at])
  @@index([owner_module])
  @@map("media")
}

model MediaFolder {
  id         String   @id @default(cuid())
  name       String
  parent_id  String?
  created_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  parent   MediaFolder?  @relation("FolderTree", fields: [parent_id], references: [id], onDelete: Cascade)
  children MediaFolder[] @relation("FolderTree")
  media    Media[]
  shares   MediaShare[]

  @@unique([parent_id, name])
  @@index([parent_id])
  @@map("media_folders")
}

model MediaUsage {
  id         String   @id @default(cuid())
  media_id   String
  entity     String
  entity_id  String
  created_at DateTime @default(now())

  media Media @relation(fields: [media_id], references: [id], onDelete: Cascade)

  @@unique([media_id, entity, entity_id])
  @@index([media_id])
  @@index([entity, entity_id])
  @@map("media_usages")
}
