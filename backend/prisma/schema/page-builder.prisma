// Page Builder module schema.
// Stores Puck page documents. The `data` column holds the Puck `Data` JSON
// tree (root props + content + zones) — the single source rendered by both the
// editor and the public /p/[slug] route.

enum PageStatus {
  DRAFT
  PUBLISHED
}

model BuilderPage {
  id         String     @id @default(cuid())
  slug       String     @unique
  title      String
  status     PageStatus @default(DRAFT)
  // Live content (what visitors see while status = PUBLISHED).
  data       Json
  // Unpublished edits of a PUBLISHED page (T6.2). Null = nothing pending. Publishing copies it to `data`.
  draft_data Json?
  // Per-page SEO (T6.1): { title, description, og_image, canonical, noindex }. Null/missing key = use defaults.
  seo        Json?
  created_by String?
  deleted_at DateTime?
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  project_id String?
  // The site this page belongs to (null only for pages made before sites, or outside any project).
  site_id    String?
  site       Site?      @relation(fields: [site_id], references: [id], onDelete: SetNull)
  // Set only for a Details Page instance (e.g. one sector's page) whose
  // structure/design is governed by a shared DetailPageTemplate instead of
  // this row's own `data` — see detail-pages.prisma. `entity_id` is the
  // specific record (e.g. Sector.id) this instance renders.
  template_id String?
  entity_id   String?

  versions PageVersion[]

  @@index([status])
  @@index([project_id])
  @@index([site_id])
  @@index([template_id])
  @@map("builder_pages")
}

// Immutable snapshot taken each time a page is published (or restored). Never updated.
model PageVersion {
  id         String      @id @default(cuid())
  page_id    String
  // 1, 2, 3 ... per page.
  version    Int
  title      String
  data       Json
  seo        Json?
  note       String?
  created_by String?
  created_at DateTime    @default(now())
  page       BuilderPage @relation(fields: [page_id], references: [id], onDelete: Cascade)

  @@unique([page_id, version])
  @@map("page_versions")
}
