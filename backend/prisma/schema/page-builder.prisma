// Page Builder module schema.
// Stores Puck page documents. The `data` column holds the Puck `Data` JSON
// tree (root props + content + zones) — the single source rendered by both the
// editor and the public /p/[slug] route.

enum PageStatus {
  DRAFT
  PUBLISHED
}

model BuilderPage {
  id         String     @id @default(cuid())
  slug       String     @unique
  title      String
  status     PageStatus @default(DRAFT)
  data       Json
  created_by String?
  deleted_at DateTime?
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  project_id String?
  // Set only for a Details Page instance (e.g. one sector's page) whose
  // structure/design is governed by a shared DetailPageTemplate instead of
  // this row's own `data` — see detail-pages.prisma. `entity_id` is the
  // specific record (e.g. Sector.id) this instance renders.
  template_id String?
  entity_id   String?

  @@index([status])
  @@index([project_id])
  @@index([template_id])
  @@map("builder_pages")
}
