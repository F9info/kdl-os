// Events module: a project's events, entered by hand or synced from a Google Developer Groups chapter
// page (gdg.community.dev). Synced rows are matched on (project_id, source, source_id), so a re-sync
// updates them in place; admin-only fields (category override, featured, hidden) are never overwritten.

model ChapterEvent {
  id          String    @id @default(cuid())
  project_id  String
  // 'manual' (entered in the admin) or 'gdg' (synced from gdg.community.dev).
  source      String    @default("manual")
  // The event id on the source (gdg.community.dev); null for manual events.
  source_id   String?
  title       String
  start_date  DateTime
  end_date    DateTime?
  venue       String?
  event_type  String?
  image_url   String?
  banner_url  String?
  // Where visitors register (a co-host registration link wins over the event page).
  register_url String?
  // The event's own page on the source.
  page_url    String?
  description String?
  tags        String[]  @default([])
  // Admin-only: overrides the category worked out from the title. Never touched by a sync.
  category    String?
  is_featured Boolean   @default(false)
  is_hidden   Boolean   @default(false)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@unique([project_id, source, source_id])
  @@index([project_id, start_date])
  @@map("chapter_events")
}

// One row per project: which chapter to sync, and what the last sync brought back.
model ChapterSyncSetting {
  id             String    @id @default(cuid())
  project_id     String    @unique
  // Numeric chapter id and URL slug on gdg.community.dev (e.g. 318 / "gdg-vizag").
  chapter_id     Int?
  chapter_slug   String?
  auto_sync      Boolean   @default(true)
  last_synced_at DateTime?
  // { ok, created, updated, error? } of the last run.
  last_result    Json?
  // Chapter facts from the last good sync.
  members_count  Int?
  logo_url       String?
  // Organizers from the chapter page: [{ name, title, avatar }].
  team           Json?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@map("chapter_sync_settings")
}

// ─── DevFest ─────────────────────────────────────────────────────────────────
// One edition per year. Speakers, sessions, sponsors and the team belong to an edition, so every
// past year keeps its own content (the archive) and next year starts as a fresh edition.

model DevfestEdition {
  id            String    @id @default(cuid())
  project_id    String
  year          Int
  name          String
  theme         String?
  start_date    DateTime?
  end_date      DateTime?
  venue         String?
  venue_address String?
  map_url       String?
  ticket_url    String?
  cfp_url       String?
  cfp_closes    DateTime?
  // Talk proposals are taken on the website while this is on and cfp_closes has not passed.
  cfp_open      Boolean   @default(false)
  // [{ name, color }] — the tracks sessions are filed under.
  tracks        Json      @default("[]")
  // [{ label, value }] — headline numbers (attendees, talks...).
  stats         Json      @default("[]")
  // The edition the website shows by default. One per project.
  is_current    Boolean   @default(false)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  speakers DevfestSpeaker[]
  sessions DevfestSession[]
  sponsors DevfestSponsor[]
  team     DevfestTeamMember[]
  proposals DevfestProposal[]

  @@unique([project_id, year])
  @@map("devfest_editions")
}

model DevfestSpeaker {
  id          String   @id @default(cuid())
  project_id  String
  edition_id  String
  slug        String
  name        String
  photo_url   String?
  role        String?
  company     String?
  bio         String?
  // { label: url } — LinkedIn, X, GitHub, website...
  links       Json     @default("{}")
  badges      String[] @default([])
  is_featured Boolean  @default(false)
  is_visible  Boolean  @default(true)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  edition DevfestEdition @relation(fields: [edition_id], references: [id], onDelete: Cascade)

  @@unique([edition_id, slug])
  @@index([project_id])
  @@map("devfest_speakers")
}

model DevfestSession {
  id          String    @id @default(cuid())
  project_id  String
  edition_id  String
  slug        String
  title       String
  abstract    String?
  // talk | keynote | workshop | panel | break
  kind        String    @default("talk")
  // A track name from the edition, or "All" for sessions everyone attends.
  track       String?
  level       String?
  room        String?
  starts_at   DateTime?
  ends_at     DateTime?
  speaker_ids String[]  @default([])
  slides_url  String?
  video_url   String?
  is_visible  Boolean   @default(true)
  sort_order  Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  edition DevfestEdition @relation(fields: [edition_id], references: [id], onDelete: Cascade)

  @@unique([edition_id, slug])
  @@index([project_id])
  @@map("devfest_sessions")
}

model DevfestSponsor {
  id         String   @id @default(cuid())
  project_id String
  edition_id String
  name       String
  logo_url   String?
  // title | gold | silver | community | partner
  tier       String   @default("partner")
  url        String?
  is_visible Boolean  @default(true)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  edition DevfestEdition @relation(fields: [edition_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@map("devfest_sponsors")
}

model DevfestTeamMember {
  id         String   @id @default(cuid())
  project_id String
  edition_id String
  name       String
  role       String?
  photo_url  String?
  url        String?
  is_visible Boolean  @default(true)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  edition DevfestEdition @relation(fields: [edition_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@map("devfest_team_members")
}

// A talk proposal sent through the call for speakers form on the website. Organizers review it in
// the admin; accepting it creates a (hidden) speaker and session in the same edition.
model DevfestProposal {
  id          String         @id @default(cuid())
  project_id  String
  edition_id  String
  edition     DevfestEdition @relation(fields: [edition_id], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String?
  city        String?
  role        String?
  company     String?
  bio         String
  photo_url   String?
  linkedin    String?
  website     String?
  title       String
  abstract    String
  // talk | workshop | lightning | panel
  format      String         @default("talk")
  track       String?
  level       String?
  notes       String?
  first_time  Boolean        @default(false)
  // new | shortlisted | waitlist | accepted | rejected
  status      String         @default("new")
  review_note String?
  speaker_id  String?
  session_id  String?
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt

  @@index([edition_id, status])
  @@index([edition_id, email])
  @@map("devfest_proposals")
}
