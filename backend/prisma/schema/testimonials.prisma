// Testimonials module (part of the CMS bundle): customer quotes shown on the public site.
model Testimonial {
  id         String   @id @default(cuid())
  project_id String?
  name       String
  role       String?
  quote      String
  photo_url  String?
  order      Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([project_id])
  @@map("testimonials")
}
