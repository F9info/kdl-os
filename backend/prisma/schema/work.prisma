// Work module schema — "Our Work" showcase categories (Central AC, Safety &
// Security, Home Automation, Home Theater, Premium Lighting), same
// list-of-entries-with-a-real-generated-page pattern as sectors.prisma.

model WorkCategory {
  id             String   @id @default(cuid())
  project_id     String?
  eyebrow        String?
  name           String
  slug           String
  subtitle       String?
  image          String?
  detail_page_id String?
  order          Int      @default(0)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([project_id])
  @@map("work_categories")
}
