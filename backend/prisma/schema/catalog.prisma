// Catalog module schema — individual product/service catalog entries
// (Cables, Generators, Switches & wiring devices, ...), same
// list-of-entries-with-a-real-generated-page pattern as sectors.prisma.
// Entries are near-identical in shape (image + heading + description +
// brand tag) so, unlike work.prisma, they share one live DetailPageTemplate
// (see detail-pages.prisma) — see sectors/service.js's resolveSectorBindings
// for the equivalent convention this module follows (resolveCatalogBindings).

model CatalogItem {
  id             String   @id @default(cuid())
  project_id     String?
  name           String
  slug           String
  category       String?
  description    String?
  image          String?
  brand_tag      String?
  // Per-item section copy keyed by Puck block type (banner eyebrow/CTAs, overview
  // row, applications, why-buy, process steps, quote form). Overlaid onto the
  // shared template's matching blocks by resolveCatalogBindings; structure and
  // design variants stay live in the template.
  content        Json?
  detail_page_id String?
  order          Int      @default(0)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([project_id])
  @@map("catalog_items")
}
