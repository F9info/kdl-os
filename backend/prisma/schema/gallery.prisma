// Gallery module (part of the CMS bundle): images shown on the public Gallery page.
model GalleryItem {
  id         String   @id @default(cuid())
  project_id String
  title      String
  image_url  String
  caption    String?
  album      String?
  order      Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([project_id])
  @@map("gallery_items")
}
