// A Site is one public thing a project publishes: the main website, or (later) a landing page.
// Pages belong to a site (BuilderPage.site_id). Each project gets one default WEBSITE site
// (created by the backfill migration and lazily by ensureDefaultSite). See docs/planning/02.

enum SiteType {
  WEBSITE
  LANDING
}

model Site {
  id         String    @id @default(cuid())
  project_id String
  type       SiteType  @default(WEBSITE)
  slug       String
  name       String
  // Custom host that resolves to this site (used by the public router, T5.2). Null = path-based.
  domain     String?   @unique
  is_default Boolean   @default(false)
  // Overrides of the project's Application Identity for this site only (T5.5). Missing/empty key =
  // inherit the project value. Keys: see SITE_IDENTITY_KEYS in projects/site-identity.js.
  identity_overrides Json?
  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  project Project       @relation(fields: [project_id], references: [id])
  pages   BuilderPage[]

  @@unique([project_id, slug])
  @@index([project_id])
  @@map("sites")
}
