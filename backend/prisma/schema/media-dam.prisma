// Media DAM — Phase A foundations (tags, custom meta fields, collections, favorites)
// Phase B prerequisite — MediaVersion bootstrapped here for Phase C
// See .agents/MEDIA_DAM_ARCH.md

enum MediaMetaFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
}

model MediaTag {
  id         String   @id @default(cuid())
  name       String   @unique
  created_at DateTime @default(now())

  media MediaTagPivot[]

  @@map("media_tags")
}

model MediaTagPivot {
  media_id String
  tag_id   String

  media Media    @relation(fields: [media_id], references: [id], onDelete: Cascade)
  tag   MediaTag @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([media_id, tag_id])
  @@index([tag_id])
  @@map("media_tag_pivot")
}

// Admin-defined custom fields: project, client, campaign, copyright, license...
model MediaMetaField {
  id         String             @id @default(cuid())
  slug       String             @unique
  label      String
  field_type MediaMetaFieldType @default(TEXT)
  options    Json?
  is_system  Boolean            @default(false)
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt

  values MediaMetaValue[]

  @@map("media_meta_fields")
}

model MediaMetaValue {
  media_id String
  field_id String
  value    String

  media Media          @relation(fields: [media_id], references: [id], onDelete: Cascade)
  field MediaMetaField @relation(fields: [field_id], references: [id], onDelete: Cascade)

  @@id([media_id, field_id])
  @@index([field_id])
  @@map("media_meta_values")
}

// Smart collections: is_smart=true → rules holds saved search filter json, evaluated at read
model MediaCollection {
  id         String   @id @default(cuid())
  name       String
  created_by String?
  is_smart   Boolean  @default(false)
  rules      Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  items MediaCollectionItem[]

  @@index([created_by])
  @@map("media_collections")
}

model MediaCollectionItem {
  collection_id String
  media_id      String
  created_at    DateTime @default(now())

  collection MediaCollection @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  media      Media           @relation(fields: [media_id], references: [id], onDelete: Cascade)

  @@id([collection_id, media_id])
  @@index([media_id])
  @@map("media_collection_items")
}

model MediaFavorite {
  user_id    String
  media_id   String
  created_at DateTime @default(now())

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  media Media @relation(fields: [media_id], references: [id], onDelete: Cascade)

  @@id([user_id, media_id])
  @@index([media_id])
  @@map("media_favorites")
}

// Phase B prerequisite — every destructive Phase C op writes a new version
model MediaVersion {
  id         String   @id @default(cuid())
  media_id   String
  version    Int
  path       String
  size       Int
  checksum   String?
  created_by String?
  note       String?
  created_at DateTime @default(now())

  media Media @relation(fields: [media_id], references: [id], onDelete: Cascade)

  @@unique([media_id, version])
  @@index([media_id])
  @@map("media_versions")
}

// Phase D — AI Layer: per-feature AI provider config (mirrors IntegrationProvider pattern)
enum AiFeature {
  VISION // captioning / auto-tagging (openrouter-vision)
  IMAGE_OPS // bg-removal / upscale / enhance / object-removal (replicate)
  SPEECH_TO_TEXT // whisper-local / openai-whisper-api
}

model AiProvider {
  id          String    @id @default(cuid())
  feature     AiFeature
  driver      String // "openrouter-vision" | "replicate" | "whisper-local" | "openai-whisper-api"
  name        String // display: "OpenRouter production"
  credentials String // AES-256-GCM encrypted JSON blob — NEVER plaintext
  config      Json? // non-secret driver config (model ids, endpoint url)
  is_active   Boolean   @default(false) // one active provider per feature (enforced in service)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@index([feature, is_active])
  @@map("ai_providers")
}

// Phase D2 — AI-generated suggestions (tags/captions/etc). Always editable, never
// applied to Media directly — a human (or auto-accept policy) must accept them.
enum MediaSuggestionType {
  TAGS
  TITLE
  DESCRIPTION
  ALT_TEXT
  SEO_KEYWORDS
}

enum MediaSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model MediaSuggestion {
  id         String                @id @default(cuid())
  media_id   String
  type       MediaSuggestionType
  value      Json // string for TITLE/DESCRIPTION/ALT_TEXT, string[] for TAGS/SEO_KEYWORDS
  source     String                @default("ai")
  status     MediaSuggestionStatus @default(PENDING)
  created_at DateTime              @default(now())
  updated_at DateTime              @updatedAt

  media Media @relation(fields: [media_id], references: [id], onDelete: Cascade)

  @@index([media_id, status])
  @@map("media_suggestions")
}
