# AI Service
AI_PORT=5000
NODE_ENV=development

# Claude — Anthropic SDK (CRITICAL/HIGH tasks)
ANTHROPIC_API_KEY=sk-ant-...
# Model id for the Claude brain. Defaults to claude-opus-5: D-BK-2 (KDL-483)
# binds the HIGH path to the flagship tier — do not downgrade without a ruling.
CLAUDE_DEFAULT_MODEL=claude-opus-5

# OpenRouter — budget brain (MEDIUM/LOW tasks)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=moonshot-ai/moonshot-v1-32k
OPENROUTER_WHISPER_MODEL=openai/whisper-1
OPENROUTER_DAILY_BUDGET=2.00

# Redis (shared with backend — same instance)
REDIS_URL=redis://localhost:6380

# ChromaDB
CHROMA_URL=http://localhost:8000

# MeiliSearch — scoped search-only key (NOT the master key)
MEILISEARCH_HOST=http://localhost:7700
MEILI_SEARCH_API_KEY=scoped-search-key

# JWT — same secret as backend so tokens are mutually verifiable
JWT_SECRET=your-jwt-secret

# Backend URL (for OpenRouter HTTP-Referer header)
BACKEND_URL=http://localhost:4000

# Brand inference (KDL-553) — logo-image input to /api/ai/brand-inference is
# ON by default (KDL-534 A/B cleared the flip). Set to 'false' to opt out.
# Note: when enabled, brand inference calls cannot be routed to a text-only
# provider — see KDL-475 spec amendment for the routing constraint.
BRAND_INFERENCE_IMAGE_ENABLED=true
